<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_templates_customer_details">
        <p t-attf-style="text-transform:capitalize; color: #{theme_color or '#ffffff'}; font-weight:bold; margin:0; margin-bottom:5px; padding:10px 0px 0px 0px;">
            <strong t-if="o.partner_shipping_id == o.partner_id">Invoicing and shipping address:</strong>
            <strong t-if="o.partner_shipping_id != o.partner_id">Invoicing address:</strong>
        </p>
        <t t-if="o.partner_id">
            <span t-attf-style="text-transform:capitalize; padding:0px; margin:0; color: #{customer_color or '#ffffff'};">
                <t t-if="o.company_id and o.company_id.is_customer_bold">
                    <strong>
                        <span t-field="o.partner_id"/>
                    </strong>
                </t>
                <t t-if="not o.company_id.is_customer_bold">
                    <span t-field="o.partner_id"/>
                </t>
            </span>
            <p t-attf-style="color: #{customer_address_color or '#ffffff'};">
                <span t-esc="o._get_street(o.partner_id)"/>
                <br/>
                <span t-esc="o._get_address_details(o.partner_id)"/>
                <br/>
                <t t-if="o.partner_id.mobile">
                    <strong>Mobile: </strong>
                    <span t-field="o.partner_id.mobile"/>
                    <br/>
                </t>
                <t t-if="o.partner_id.email">
                    <strong>Email: </strong>
                    <span t-field="o.partner_id.email"/>
                    <br/>
                </t>
                <t t-if="o.partner_id.vat">
                    <strong>Vat: </strong>
                    <span t-field="o.partner_id.vat"/>
                </t>
            </p>
        </t>

    </template>
    <template id="invoice_templates_customer_shipping_details">
        <p t-attf-style="text-transform:capitalize; color: #{theme_color or '#ffffff'}; font-weight:bold; margin:0; margin-bottom:5px; padding:10px 0px 0px 0px;"
           t-if="o.partner_shipping_id != o.partner_id">
            <strong t-if="o.partner_shipping_id  and o.partner_shipping_id != o.partner_id">Shipping address:</strong>
        </p>
        <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
            <span t-attf-style="text-transform:capitalize; padding:0px; margin:0; color: #{customer_color or '#ffffff'};">
                <t t-if="o.company_id and o.company_id.is_customer_bold">
                    <strong>
                        <span t-field="o.partner_shipping_id"/>
                    </strong>
                </t>
                <t t-if="not o.company_id.is_customer_bold">
                    <span t-field="o.partner_shipping_id"/>
                </t>
            </span>
            <p t-attf-style="color: #{customer_address_color or '#ffffff'};">
                <span t-esc="o._get_street(o.partner_shipping_id)"/>
                <br/>
                <span t-esc="o._get_address_details(o.partner_shipping_id)"/>
                <br/>
                <t t-if="o.partner_shipping_id.mobile">
                    <strong>Mobile: </strong>
                    <span t-field="o.partner_shipping_id.mobile"/>
                    <br/>
                </t>
                <t t-if="o.partner_shipping_id.email">
                    <strong>Email: </strong>
                    <span t-field="o.partner_shipping_id.email"/>
                    <br/>
                </t>
                <t t-if="o.partner_shipping_id.vat">
                    <strong>Vat: </strong>
                    <span t-field="o.partner_shipping_id.vat"/>
                </t>
            </p>
        </t>
    </template>
    <template id="templates_company_details">
        <div t-attf-style="color: #{company_color or '#ffffff'};">
            <span t-att-style="'text-transform:capitalize; padding:0px; margin:0;'">
                <t t-if="o.company_id and o.company_id.is_company_bold">
                    <strong>
                        <span t-field="o.company_id.partner_id"/>
                    </strong>
                </t>
                <t t-if="not o.company_id.is_company_bold">
                    <span t-field="o.company_id.partner_id"/>
                </t>
            </span>
        </div>
        <div t-attf-style="color: #{company_address_color or '#ffffff'};">
            <span t-esc="o._get_street(o.company_id.partner_id)"/>
            <br/>
            <span t-esc="o._get_address_details(o.company_id.partner_id)"/>
            <br/>
            <t t-if="o.company_id.partner_id.mobile">
                <strong>Mobile: </strong>
                <span t-field="o.company_id.partner_id.mobile"/>
                <br/>
            </t>
            <t t-if="o.company_id.partner_id.email">
                <strong>Email: </strong>
                <span t-field="o.company_id.partner_id.email"/>
                <br/>
            </t>
        </div>
    </template>
    <!--  <template id="templates_customer_details"><div t-att-style="'margin:0; padding-top:0; color:'+customer_address_color+';'"><span t-esc="o._get_street(o.partner_id)"/><br/><span t-esc="o._get_address_details(o.partner_id)"/><br/><t t-if="o.partner_id.mobile"><strong>Mobile: </strong><span t-field="o.partner_id.mobile"/><br/></t><t t-if="o.partner_id.email"><strong>Email: </strong><span t-field="o.partner_id.email"/><br/></t><t t-if="o.partner_id.vat"><strong>TIN: </strong><span t-field="o.partner_id.vat"/><br/></t></div></template>-->
    <template id="template_watermark">
        <t t-if="o.company_id and o.company_id.is_show_watermark">
            <t t-if="o.company_id.watermark == 'logo'">
                <div class="watermark text-center">
                    <img t-att-src="image_data_uri(o.company_id.watermark_logo)"
                         style="position:absolute; left:60px; top:2px; z-index:-1" width="85%; height=auto"/>
                </div>
            </t>
            <t t-if="o.company_id.watermark != 'logo'">
                <div class="watermark text-center"
                     style="position:absolute; opacity:0.25; width:100%; height:auto; z-index:1000; -webkit-transform: rotate(-45deg); -moz-transform:rotate(-45deg); bottom:-600px; left:-100px;">
                    <span t-att-style="'font-size:'+str(o.company_id.watermark_text_font_size)+'em; color:'+o.company_id.watermark_text_color">
                        <span t-field="o.company_id.watermark_text" t-if="o.company_id.watermark == 'text'"/>
                        <span t-field="o.state" t-if="o.company_id.watermark == 'status'"/>
                    </span>
                </div>
            </t>
        </t>
    </template>
    <template id="template_total_amount_word">
        <t t-if="o.company_id.add_amount_in_words == True">
            <span t-attf-style="color: #{text_color or '#000000'};padding-bottom: 5px;">
                <t t-esc="o.amount_to_text"/>
            </span>
        </t>
    </template>

    <template id="report_invoice_order_lines">
        <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
        <table BORDERCOLOR="#{theme_color or '#000000'}" border="1" cellpadding="0" cellspacing="0"
               class="table table-bordered"
               style="border:0.5px solid #ccc;  border-collapse: collapse; text-transform:capitalize; padding:10px;"
               width="100%">
            <thead>
                <tr t-attf-style="page-break-inside: avoid !important;background-color: #{theme_color or '#000000'}; color: #{theme_text_color or '#000000'};">
                    <td align="center"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="6%">ITEM</td>
                    <td align="left"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="48%">DESCRIPCIÓN</td>
                    <td align="right"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="8%">CANTIDAD</td>
                    <td align="right"
                        t-attf-style="padding:5px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="10%">V. UNI</td>
                    <td align="right"
                        t-attf-style="padding:5px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="10%">P. UNI</td>
                    <td align="center"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="8%">Desc.(%)</td>
                    <td align="right"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="10%">VALOR NETO</td>
                </tr>
            </thead>
            <tbody>
                <t t-as="l" t-foreach="o.invoice_line_ids">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="o.company_id.even_party_color"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="o.company_id.odd_party_color"/>
                    </t>
                    <tr t-att-style="'page-break-inside: avoid !important; color: %s; background-color: %s '%(text_color, ol_color)  ">
                        <t t-if="not l.display_type">
                            <td class="text-center"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <span t-esc="l_index+1"/>
                            </td>
                            <td class="text-left"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <t t-if="not o.company_id.is_description">
                                    <span t-field="l.product_id and l.product_id.name"/>
                                </t>
                                <t t-if="o.company_id.is_description">
                                    <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                </t>
                            </td>
                            <td class="text-right"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <span t-field="l.quantity"/>
                            </td>
                            <td class="text-right"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <span t-field="l.price_unit"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                            <td class="text-right" groups="product.group_discount_per_so_line"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '"
                                t-if="display_discount">
                                <span t-field="l.discount"/>
                            </td>
                            <td class="text-right"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_ids))"/>
                            </td>
                            <td class="text-right"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <span t-field="l.price_subtotal"
                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </t>
                        <t t-if="l.display_type == 'line_section'">
                            <td class="text-center"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important;'">
                                <span t-esc="l_index+1"/>
                            </td>
                            <td t-att-colspan="6">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                            <t t-set="current_section" t-value="l"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-if="l.display_type == 'line_note'">
                            <td class="text-center"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important;'">
                                <span t-esc="l_index+1"/>
                            </td>
                            <td t-att-colspan="6">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                        </t>
                    </tr>
                </t>
                <t t-as="l" t-foreach="o.invoice_line_ids">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="o.company_id.even_party_color"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="o.company_id.odd_party_color"/>
                    </t>
                    <tr t-att-style="'page-break-inside: avoid !important; color: %s; background-color: %sB3 '%(text_color, ol_color)  ">
                        <td class="text-center"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-esc="l_index+1"/>
                        </td>
                        <t t-if="o.company_id.is_description">
                            <td class="text-left"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <t t-if="not o.company_id.is_description">
                                    <span t-field="l.product_id and l.product_id.name"/>
                                </t>
                                <t t-if="o.company_id.is_description">
                                    <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                </t>
                            </td>
                        </t>
                        <td align="right"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-field="l.quantity"/>
                        </td>
                        <td align="right"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-out="'{:.{}f}'.format(round(l.price_subtotal/l.quantity,4),4)"/>
                        </td>
                        <td align="right"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-out="'{:.{}f}'.format(round(l.price_total/l.quantity,2),2)"/>
                        </td>
                        <td align="center"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-field="l.discount"/>
                        </td>
                        <!--                        <td class="text-right"-->
                        <!--                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">-->
                        <!--                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_ids))"/>-->
                        <!--                        </td>-->
                        <td align="right"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-field="l.price_subtotal"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </td>
                        <t t-if="l.display_type == 'line_section'">
                            <td class="text-center"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important;'">
                                <span t-esc="l_index+1"/>
                            </td>
                            <td t-att-colspan="6">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                            <t t-set="current_section" t-value="l"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-if="l.display_type == 'line_note'">
                            <td class="text-center"
                                t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important;'">
                                <span t-esc="l_index+1"/>
                            </td>
                            <td t-att-colspan="6">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="document_tax_totals_custom">
        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
            <tr class="border-black o_subtotal">
                <td><strong t-esc="subtotal['name']"/></td>

                <td class="text-end">
                    <span
                            t-att-class="oe_subtotal_footer_separator"
                            t-esc="subtotal['formatted_amount']"
                    />
                </td>
            </tr>

            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
            <t t-call="general_template.tax_groups_totals_custom"/>
        </t>


        <tr class="tm_gray_bg"
            t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold; background-color: #{o.company_id and o.company_id.theme_color or '#000000'};">
            <td><strong>Total</strong></td>
            <td class="text-end">
                <span t-esc="tax_totals['formatted_amount_total']"/>
            </td>
        </tr>
    </template>

    <template id="tax_groups_totals_custom">
        <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]" t-as="amount_by_group">
            <tr>
                <t t-if="tax_totals['display_tax_base']">
                    <td>
                        <span t-esc="amount_by_group['tax_group_name']"/>
                        <span class="text-nowrap"> on
                            <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                        </span>
                    </td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                    </td>
                </t>
                <t t-else="">
                    <td><span class="text-nowrap" t-esc="amount_by_group['tax_group_name']"/></td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                    </td>
                </t>
            </tr>
        </t>
    </template>
    <template id="invoice_subtotal_tem">
        <p class="mb-2 mt-6" style="page-break-after: auto;">
            <div class="row">
                <!-- Resumen -->
                <div class="col-4">
                    <t t-set="extra_edi_vals" t-value="o._l10n_pe_edi_get_extra_report_values()"/>
                    <t t-set="spot" t-value="o._l10n_pe_edi_get_spot()"/>
                    <p>
                        <b>SON:</b><br/>
                        <span t-out="extra_edi_vals.get('amount_to_text')"/>
                    </p>
                    <p>
                        <b>RESÚMEN:</b><br/>
                        <t t-if="extra_edi_vals">
                            <span t-out="extra_edi_vals['qr_str'].split('|')[9]"/>
                        </t>
                    </p>
                    <p t-if="spot" t-esc="spot['spot_message']"/>
                </div>

                <!-- qr -->
                <div class="col-4" style="justify-content: center;align-items: center;">
                    <div style="text-align: center;">
                        <img t-if="extra_edi_vals" class="p-2" style="background-color: #ffffff; border-radius:8px;"
                             t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', extra_edi_vals['qr_str'], 100, 100)"/>
                    </div>
                </div>

                <!-- Totales -->
                <div class="fix col-4"
                     t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                    <div id="total1" class="rows">
                        <div t-attf-class="#{'col-12' if report_type != 'html' else 'col-sm-12 col-md-10'} ms-auto">
                            <table class="table table-striped">
                                <!--Tax totals-->
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="general_template.document_tax_totals_custom"/>
                                <tr t-if="print_with_payments">
                                    <t t-if="o.payment_state != 'invoicing_legacy'">
                                        <t t-set="payments_vals"
                                           t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <tr t-if="payment_vals['is_exchange'] == 0">
                                                <td>
                                                    <i class="oe_form_field text-end oe_payment_label">Paid on <t
                                                            t-esc="payment_vals['date']"
                                                            t-options='{"widget": "date"}'/></i>
                                                </td>
                                                <td class="text-end">
                                                    <span t-esc="payment_vals['amount']"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="len(payments_vals) > 0">
                                            <tr class="border-black"
                                                t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold; background-color: #{o.company_id and o.company_id.theme_color or '#000000'};">
                                                <td><strong>Amount Due</strong></td>
                                                <td class="text-end">
                                                    <span t-field="o.amount_residual"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </p>
    </template>

    <template id="report_cuotas_custom">
        <table BORDERCOLOR="#{theme_color or '#000000'}" border="1" cellpadding="0" cellspacing="0"
               class="table table-bordered"
               style="border:0.5px solid #ccc;  border-collapse: collapse; text-transform:capitalize; padding:15px;border-bottom:1px solid #ccc;"
               width="100%">
            <thead>
                <tr t-attf-style="background-color: #{theme_color or '#000000'}; color: #{theme_text_color or '#000000'};">
                    <td align="center"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="10%">CUOTA</td>
                    <td align="center"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="20%">FECHA VENCIMIENTO</td>
                    <td align="center"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="30%">IMPORTE</td>
                    <td align="center"
                        t-attf-style="padding:5px 10px; border:1px solid #{theme_color or '#000000'} !important; border-right:0px solid #{theme_color or '#000000'} !important; font-weight:bold;"
                        width="30%">MONEDA</td>
                </tr>
            </thead>
            <tbody>
                <t t-set="spot1" t-value="o._l10n_pe_edi_get_spot()"/>
                <t t-set="first_time" t-value="True"/>
                <t t-foreach="o.line_ids.filtered(lambda l: l.account_type == 'asset_receivable')" t-as="rec_line">
                    <t t-set="amount" t-value="rec_line.amount_currency"/>
                    <t t-if="spot1 and first_time">
                        <t t-set="amount" t-value="amount-spot1['spot_amount']"/>
                    </t>
                    <t t-set="first_time" t-value="False"/>
                    <tr t-att-style="'color: %s'">
                        <td class="text-center"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-out="rec_line_index+1"/>
                        </td>
                        <td class="text-center"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-field="rec_line.date_maturity"/>
                        </td>
                        <td class="text-center"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-out="rec_line.move_id.currency_id.round(amount)"/>
                        </td>
                        <td class="text-center"
                            t-att-style="'padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                            <span t-out="rec_line.move_id.currency_id.name"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="report_invoice_signature">
        <t t-if="o.company_id.is_show_signature == True">
            <!-- <img style="max-height: 80px; padding:5px;" t-att-src="'data:image/png;base64,%s' %  to_text(o.company_id.signature)" t-if="o.company_id.signature"/> -->
            <img t-att-src="image_data_uri(o.company_id.signature)" style="max-height: 60px;"/>

        </t>
    </template>
    <template id="report_invoice_barcode">
        <div class="row" t-if="o.company_id.is_show_barcode == True">
            <div style="position:absolute; width:100%; text-align:center;">
                <!-- <img style="width:190px; height:35px;" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 600, 100)"/> -->
                <span t-field="o.name" t-options="{'widget':'barcode','width':190,'height':35}"/>
            </div>
        </div>
    </template>
    <template id="report_invoice_notes">
        <ul t-attf-style="padding-left:15px; margin:0; color: #{text_color or '#000000'};">
            <li t-if="o.invoice_payment_term_id.name and o.company_id.is_show_payment_notes == 'True'">
                <b>Payment Terms: </b>
                <span t-field="o.invoice_payment_term_id.name"/>
            </li>
            <li t-if="o.invoice_incoterm_id and o.company_id.is_show_payment_notes == 'True'">
                <b>Incoterm: </b>
                <span t-field="o.invoice_incoterm_id.name"/>
            </li>
            <li t-if="o.invoice_payment_term_id.note and o.company_id.is_show_payment_description == True">
                <b>Payment Terms Description: </b>
                <span t-field="o.invoice_payment_term_id.note"/>
            </li>

        </ul>
        <div class="row" t-if="o.display_qr_code">
            <div style="position:absolute; width:100%; text-align:center;">
                <div id="qrcode" t-if="o.display_qr_code and o.amount_residual > 0">
                    <p t-if="qr_code_urls.get(o.id)">
                        <strong class="text-center">Scan me with your banking app.</strong><br/><br/>
                        <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>
                    </p>
                </div>
            </div>
        </div>
    </template>
    <template id="template_footer">
        <div class="footer"
             t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'"
             t-if="o.company_id.report_footer_selection == 'standard'">
            <div class="text-center" style="border-top: 1px solid black;">
                <div name="financial_infos">
                    <strong t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                            t-field="company.report_footer"/>
                </div>
                <div class="text-muted">Page:
                    <span class="page"/>
                    /
                    <span class="topage"/></div>
            </div>
        </div>
        <div class="footer"
             t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;width:100%; text-align:center; border-top:1px solid #d9d9d9;'"
             t-if="o.company_id.report_footer_selection == 'multi_columns'">
            <div class="col-md-4 text-center"
                 style="width:33%; flex: 0 0 33%; max-width: 33%; display:inline-block; text-align:center; vertical-align: top;margin-top: 25px;height: 128px;">
                <span t-field="o.company_id.name"/>
                <br/>
                <span t-esc="o._get_street(o.company_id.partner_id)"/>
                <br/>
                <span t-esc="o._get_address_details(o.company_id.partner_id)"/>
            </div>
            <div class="col-md-4 text-center"
                 style="width:33%; flex: 0 0 33%; max-width: 33%; display:inline-block; text-align:center; vertical-align: top;margin-top: 25px;height: 128px;">
                <span t-field="o.company_id.phone"/>
                <br/>
                <span t-field="o.company_id.website"/>
                <br/>
                <span t-field="o.company_id.email"/>
                <br/>
                <!-- Put social in one line
                <icon>Website name + <icon>twitter + <icon>googleplus
                 -->
            </div>
            <div class="col-md-4 text-center"
                 style="width:33%; flex: 0 0 33%; max-width: 33%; margin-top: 25px; margin-bottom:20px; display: inline-block; text-align:center; vertical-align: top;">
                <!-- <img style='max-height: 110px;max-width:100%;' t-att-src="'data:image/png;base64,%s' % to_text(o.company_id.logo_footer)"/> -->
                <span t-options="{'widget':'image',
                'img_style':'width:80px;height:80px','height':'80px','width':'80px'}"
                      t-field="o.company_id.logo_footer"/>
            </div>
        </div>
    </template>
</odoo>
