<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="exclusive_external_layout">
            <!-- Multicompany -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"/>
            </t>
            <t t-call="general_template.exclusive_header"/>
            <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
                 t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-out="0"/>
            </div>
            <t t-call="general_template.template_footer"/>
        </template>
        <template id="exclusive_header">
            <div class="header container" style="width:100%;height:10%"
                 t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tbody>
                        <tr>
                            <td>
                                <center>
                                    <table border="0" cellpadding="0" cellspacing="0"
                                           style="padding:0px 20px 0px 20px; margin:0; background:#fff; line-height:20px;"
                                           width="100%">
                                        <tr>
                                            <td align="left" colspan="2"
                                                t-attf-style="color:#{text_color or '#ffffff'}; padding:0 0px;"
                                                valign="top">
                                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                    <tr>
                                                        <td align="left"
                                                            style="color:#4D4D4F; padding: 0px 15px; border-right: 1px solid #188DC7;"
                                                            valign="middle">
                                                            <img t-att-src="image_data_uri(o.company_id.invoice_logo)"
                                                                 style="height: 100px;" t-if="o.company_id.logo"/>
                                                        </td>
                                                        <td style="padding:10px 0 10px 10px; width:66%; line-height:16px"
                                                            valign="top">
                                                            <strong t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                                                                    t-field="o.company_id.name"/><br/>
                                                            <t t-if="o.company_id.vat">
                                                                <strong t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};">
                                                                    RUC: <t t-out="o.company_id.vat"/></strong><br/>
                                                            </t>
                                                            <t t-if="o.company_id.street">
                                                                <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                                                                      t-field="o.company_id.street"/><br/>
                                                            </t>
                                                            <t t-if="o.company_id.phone">
                                                                <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                                                                      t-field="o.company_id.phone"/><br/>
                                                            </t>
                                                            <t t-if="o.company_id.email">
                                                                <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                                                                      t-field="o.company_id.email"/><br/>
                                                            </t>
                                                            <t t-if="o.company_id.website">
                                                                <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                                                                      t-field="o.company_id.website"/>
                                                            </t>
                                                        </td>

                                                        <td align="right" style="font-size:14px; padding:0; width:50%;"
                                                            valign="top">
                                                            <h6 t-attf-style="background-color: #{o.company_id and o.company_id.theme_color or '#000000'}; color: #{o.company_id and o.company_id.theme_text_color or '#000000'}; text-align:center;font-weight:bold; text-transform:uppercase; padding: 20px 0px;width: 240px; border-radius: 10px; line-height:25px;">
                                                                <span>RUC:
                                                                    <span t-esc="o.company_id.vat"/>
                                                                </span> <br/>
                                                                <t t-if="o.l10n_latam_document_type_id">
                                                                    <span t-field="o.l10n_latam_document_type_id.report_name"/>
                                                                </t>
                                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'proforma2'">
                                                                    PRO-FORMA</span>
                                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                                                    Draft Invoice</span>
                                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                                                    Cancelled Invoice</span>
                                                                <span t-if="o.move_type == 'in_refund'">Vendor
                                                                    Refund</span>
                                                                <span t-if="o.move_type == 'in_invoice'">Vendor
                                                                    Bill</span>
                                                                <br/>
                                                                <span t-field="o.name"/>
                                                            </h6>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </center>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div>
                    <p t-attf-style="border-bottom:1px solid #{theme_color};width:100%;padding:10px;"/>
                </div>
            </div>
        </template>
        <template id="report_invoice_exclusive_main">
            <t t-call="general_template.exclusive_external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <t t-set="theme_color" t-value="o.company_id and o.company_id.theme_color"/>
                <t t-set="theme_text_color" t-value="o.company_id and o.company_id.theme_text_color"/>
                <t t-set="company_color" t-value="o.company_id and o.company_id.company_color"/>
                <t t-set="company_address_color" t-value="o.company_id and o.company_id.company_address_color"/>
                <t t-set="customer_color" t-value="o.company_id and o.company_id.customer_color"/>
                <t t-set="customer_address_color" t-value="o.company_id and o.company_id.customer_address_color"/>
                <t t-set="text_color" t-value="o.company_id and o.company_id.text_color"/>
                <div class="page"
                     t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                    <div class="oe_structure"/>
                    <t t-call="general_template.template_watermark"/>

                    <div t-attf-style="color: #{o.company_id and o.company_id.text_color or '#000000'};">

                        <div name="customer_name_address" class="row mb-1" t-attf-style="color: #{o.company_id and o.company_id.text_color or '#000000'};justify-content: space-between;">
                            <div class="col-6 mx-1" t-attf-style="border-radius: 10px;border: 2px solid #{o.company_id.theme_color or '#666'};padding: 8px; width:49.6%">
                                <b>SEÑOR(ES):</b>
                                <p style="text-transform:uppercase;">
                                    <span t-field="o.partner_id.name"/><br/>
                                    <span><t t-out="o.partner_id.l10n_latam_identification_type_id.name"/>: <t
                                            t-out="o.partner_id.vat"/></span>
                                </p>
                            </div>
                            <div class="col-6 mx-1" t-attf-style="border-radius: 10px;border: 2px solid #{o.company_id.theme_color or '#666'};padding: 8px; width:49.6%">
                                <b>DIRECCIÓN:</b>
                                <p style="text-transform:uppercase;">
                                    <span>
                                        <t t-if="o.partner_id.street" t-out="o.partner_id.street"/>
                                        <t t-if="o.partner_id.l10n_pe_district">
                                            - <t t-out="o.partner_id.l10n_pe_district.name"/>
                                        </t>
                                        <t t-if="o.partner_id.city">
                                            - <t t-out="o.partner_id.city"/>
                                        </t>
                                        <t t-if="o.partner_id.state_id">
                                            - <t t-out="o.partner_id.state_id.name"/>
                                        </t>
                                        <t t-if="o.partner_id.country_id">
                                            - <t t-out="o.partner_id.country_id.name"/>
                                        </t>
                                    </span>
                                </p>
                            </div>
                        </div>

                        <div class="row mb-2"
                             t-attf-style="border-radius: 10px;border: 2px solid #{o.company_id.theme_color or '#666'};padding: 8px;height:auto;margin:0.4%;width:100%">
                            <div style="width:20%">
                                <b>VENDEDOR(A):</b><br/>
                                <p class="m-0" t-field="o.invoice_user_id"/>
                            </div>
                            <div style="width:20%">
                                <b>FECHA EMISIÓN:</b><br/>
                                <span t-out="o.invoice_date"/>
                            </div>
                            <div style="width:20%">
                                <b>FECHA VCTO.:</b><br/>
                                <span t-out="o.invoice_date_due"/>
                            </div>
                            <div style="width:20%">
                                <b>COND. DE PAGO:</b><br/>
                                <p class="m-0" t-field="o.invoice_payment_term_id"/>
                            </div>
                            <div style="width:20%">
                                <b>N° GUÍA:</b><br/>
                                <t t-foreach="o.picking_ids" t-as="picking">
                                    <span t-out="picking.l10n_latam_document_number"
                                          t-if="picking.l10n_latam_document_number"/>
                                </t>
                            </div>
                        </div>
                    </div>


                    <div style="padding:0px 0px 0 0; font-weight:bold; width:100%;">
                        <t t-call="general_template.report_invoice_order_lines"/>
                    </div>
                    <div>
                        <t t-call="general_template.invoice_subtotal_tem"/>
                    </div>
                    <div class="mt-4">
                        <t t-call="general_template.report_cuotas_custom"/>
                    </div>

                    <div t-if="not o._compute_payments_widget_reconciled_info()">
                        <p t-att-style="'font-weight:bold; color:#000; margin-bottom:0; text-transform:capitalize; margin-top:8px; color: %s;' % (text_color)">
                           Estado de pago:
                            <span t-esc="dict(o._fields['payment_state']._description_selection(o.env)).get(o.payment_state)"/>
                        </p>
                    </div>
                    <div class="pull-left" style="color: #{text_color or '#000000'}; padding-top:5px; ">
                        <t t-call="general_template.report_invoice_notes"/>
                    </div>
                    <div align="right" style="color: #{text_color or '#000000'};">
                        <t t-call="general_template.report_invoice_signature"/>
                    </div>
                    <div class="oe_structure"/>
                    <t t-call="general_template.report_invoice_barcode"/>
                </div>
            </t>
        </template>
        <template id="report_invoice_template_custom_exclusive">
            <t t-call="web.html_container">
                <t t-as="o" t-foreach="docs">
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-call="general_template.report_invoice_exclusive_main" t-lang="lang"/>
                </t>
            </t>
        </template>
        <template id="report_invoice_exclusive_main_duplicate"
                  inherit_id="general_template.report_invoice_exclusive_main" primary="True">
        </template>
    </data>
</odoo>
