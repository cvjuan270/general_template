<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_exclusive_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.sale_exclusive_header"/>
        <div class="article o_report_layout_standard" t-att-data-oe-id="o and o.id" t-att-data-oe-model="o and o._name"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="general_template.template_footer"/>
    </template>
    <template id="sale_exclusive_header">
        <div class="header container" style="width:100%;height:10%"
             t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
            <div class="row">
                <div class="col-8">

                    <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};">
                        Datos para emitir OC:
                    </span><br/>
                    <strong t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};">
                        <t t-esc="o.company_id.name"/><br/>
                        RUC: <t t-esc="o.company_id.vat"/><br/>
                    </strong>
                    <t t-if="o.company_id.street">
                        <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};">
                            <t t-esc="o.company_id.street"/>
                            <t t-if="o.company_id.partner_id.l10n_pe_district">
                                <t t-esc="' - ' + o.company_id.partner_id.l10n_pe_district.name"/>
                            </t>
                            <t t-if="o.company_id.partner_id.state_id">
                                <t t-esc="' - ' + o.company_id.partner_id.state_id.name"/>
                            </t>
                            <t t-if="o.company_id.partner_id.zip">
                                <t t-esc="' - ' + o.company_id.partner_id.zip"/>
                            </t>
                        </span><br/>
                    </t>
                    <t t-if="o.company_id.phone">
                        <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                              t-field="o.company_id.phone"/><br/>
                    </t>
                    <t t-if="o.company_id.email">
                        <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                              t-field="o.company_id.email"/><br/>
                    </t>
                    <t t-if="o.company_id.website">
                        <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};"
                              t-field="o.company_id.website"/>
                    </t>
                </div>
                <div class="col-4">
                    <div style="position:absolute; top:0; right:0;">
                        <t t-if="o.company_id.invoice_logo or o.company_id.logo">
                            <img t-att-src="image_data_uri(o.company_id.invoice_logo)" style="height: 100px;"
                                 t-if="o.company_id.logo"/>
                        </t>
                    </div>
                </div>
            </div>
            <div>
                <p t-attf-style="border-bottom:1px solid #{company_address_color};width:100%;"/>
            </div>
        </div>
    </template>
    <template id="report_sale_exclusive_main">
        <t t-call="general_template.sale_exclusive_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <t t-set="theme_color" t-value="o.company_id and o.company_id.theme_color"/>
            <t t-set="theme_text_color" t-value="o.company_id and o.company_id.theme_text_color"/>
            <t t-set="company_color" t-value="o.company_id and o.company_id.company_color"/>
            <t t-set="company_address_color" t-value="o.company_id and o.company_id.company_address_color"/>
            <t t-set="customer_color" t-value="o.company_id and o.company_id.customer_color"/>
            <t t-set="customer_address_color" t-value="o.company_id and o.company_id.customer_address_color"/>
            <t t-set="text_color" t-value="o.company_id and o.company_id.text_color"/>
            <div class="page"
                 t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <t t-call="general_template.template_watermark"/>
                <div width="100%">
                    <div>
                        <p class="table table-borderless"
                           t-attf-style="color: #{o.company_id and o.company_id.theme_color or '#000000'};font-weight:bold;width:100%;font-size:24px; text-align:center'">
                            <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                                <span t-if="o.state not in ['draft','sent']">Orden de Venta </span>
                                <span t-if="o.state in ['draft','sent']">Cotización </span>
                            </t>
                            <t t-if="env.context.get('proforma', False) or is_pro_forma">
                                <span>Pro-Forma Invoice # </span>
                            </t>
                            <span t-field="o.name"/>
                        </p>
                    </div>
                    <div t-att-class="temp_var"
                         style="border-radius: 10px;border: 2px solid #666;padding: 10px;height: auto;margin-bottom:0.5rem;">
                        <strong t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};font-weight:bold;width:100%;">
                            SEÑORES: <t t-out="o.partner_id.name"/>
                        </strong><br/>
                        <span>Por medio de la presente lo saludamos cordialmente y a la vez hacemos llegar la cotización
                            de acuerdo a lo solicitado:</span>
                    </div>

                    <div t-att-class="temp_var"
                         t-attf-style="color: #{o.company_id and o.company_id.company_address_color or '#000000'};border-radius: 10px;border: 2px solid #666;padding: 10px;height: auto;">
                        <div class="row">
                            <div class="col-2">
                                <strong>Fecha Cotización:</strong><br/>
                                <span t-field="o.date_order"/>
                            </div>
                            <div class="col-2">
                                <strong>Fecha Vcto.:</strong><br/>
                                <span t-field="o.validity_date"/>
                            </div>
                            <div class="col-2">
                                <strong>Cotizado Por:</strong><br/>
                                <span t-field="o.user_id"/>
                            </div>
                            <div class="col-4">
                                <strong>Email:</strong><br/>
                                <span t-field="o.user_id.partner_id.email"/>
                            </div>
                            <div class="col-2">
                                <strong>Término de Pago:</strong><br/>
                                <span t-field="o.payment_term_id.name"/>
                            </div>
                        </div>
                    </div>

                    <div align="left" style="padding:10px 0px 0 0; font-weight:bold; width:100%;" valign="top">
                        <t t-call="general_template.sale_order_lines_tem"/>
                        <t t-call="general_template.sale_order_lines_subtotal_tem"/>
                    </div>

                    <div class="left" style="color: #{text_color or '#000000'}; padding-top:10px; ">
                        <t t-call="general_template.sale_templates_notes"/>
                    </div>
                    <div t-if="o.sale_order_option_ids and o.state in ['draft', 'sent']">
                        <t t-call="general_template.sale_templates_suggested_order_line"/>
                    </div>
                    <div class="container-fluid">
                        <div class="row" style="color: #{text_color or '#000000'};">
                            <div class="col-9">
                            </div>
                            <!-- <div class="col-3">
                                <t t-if="o.sale_is_show_signature == True">
                                    <t t-call="general_template.report_sale_signature"/>
                                </t>
                                <t t-else="">
                                    <t t-call="general_template.report_signature"/>
                                </t>
                            </div> -->
                        </div>
                    </div>
                </div>
                <t t-call="general_template.report_barcode"/>

                <!-- show notes -->
                <div class="oe_structure"/>
                <div class="row">
                    <div class="col-8">
                        <div style="color: #{text_color or '#000000'}; padding-top:10px;">
                            <p><t t-out="o.note"/></p>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_sale_order_custom_exclusive">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <t t-call="general_template.report_sale_exclusive_main" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
